import React, { useState, useEffect, useRef } from 'react';
import { useNavigate } from 'react-router-dom';
import { Brain, Heart, Star, CheckCircle, Sparkles, Shield, ArrowRight, AlertCircle, RefreshCw } from "lucide-react";

interface WelcomeOverlayProps {
    isOpen: boolean;
    onClose: () => void;
    allMediaReady: boolean;
    loadedMedia: number;
    totalMedia: number;
    agreedToTerms: boolean;
    setAgreedToTerms: (value: boolean) => void;
}

export const WelcomeOverlay: React.FC<WelcomeOverlayProps> = ({
    isOpen,
    onClose,
    allMediaReady,
    loadedMedia,
    totalMedia,
    agreedToTerms,
    setAgreedToTerms,
}) => {
    const navigate = useNavigate();
    const [currentImageIndex, setCurrentImageIndex] = useState(0);
    const [hasBeenShown, setHasBeenShown] = useState(false);
    const [downloadError, setDownloadError] = useState(false);
    const [retryCount, setRetryCount] = useState(0);
    const [isAutoAgreeing, setIsAutoAgreeing] = useState(false);
    const [downloadComplete, setDownloadComplete] = useState(false);
    const maxRetries = 3;
    const retryTimeoutRef = useRef<NodeJS.Timeout | null>(null);

    const backgroundImages = [
        "/high6.png",
        "/high4.png",
        "/indexbackground2.jpg",
        "/background05.jpg",
    ];

    // Check if overlay has been shown before
    useEffect(() => {
        const shown = localStorage.getItem('welcomeOverlayShown');
        if (shown === 'true') {
            setHasBeenShown(true);
            if (isOpen) {
                onClose();
            }
        }
    }, []);

    // Auto-rotate background images
    useEffect(() => {
        if (!isOpen) return;
        const interval = setInterval(() => {
            setCurrentImageIndex((prev) => (prev + 1) % backgroundImages.length);
        }, 5000);
        return () => clearInterval(interval);
    }, [isOpen, backgroundImages.length]);

    // Handle auto-agreement when downloads complete
    useEffect(() => {
        // When all media is ready AND the user hasn't already agreed
        if (allMediaReady && !agreedToTerms && !isAutoAgreeing && isOpen) {
            // Small delay to ensure UI updates properly
            const timer = setTimeout(() => {
                setDownloadComplete(true);
                setIsAutoAgreeing(true);

                // Auto-check the agreement
                setAgreedToTerms(true);

                // After a moment, show that we're ready to proceed
                setTimeout(() => {
                    setIsAutoAgreeing(false);
                }, 1000);
            }, 800);

            return () => clearTimeout(timer);
        }

        // Reset download complete state when not all media is ready
        if (!allMediaReady) {
            setDownloadComplete(false);
            setDownloadError(false);
        }
    }, [allMediaReady, agreedToTerms, isAutoAgreeing, isOpen, setAgreedToTerms]);

    // Monitor download progress for errors
    useEffect(() => {
        // If downloads seem stuck (no progress for a while)
        if (loadedMedia > 0 && loadedMedia < totalMedia && !downloadError) {
            const progress = loadedMedia / totalMedia;
            const isStuck = progress < 0.5 && loadedMedia === loadedMedia; // Same as previous
            // We'll use a timeout to detect stuck downloads
            if (isStuck) {
                setDownloadError(true);
            }
        }
    }, [loadedMedia, totalMedia, downloadError]);

    // Handle retry for downloads
    const handleRetryDownload = () => {
        if (retryCount < maxRetries) {
            setRetryCount(prev => prev + 1);
            setDownloadError(false);
            // Trigger a re-download by clearing and re-adding media
            // This should be handled by your parent component
            // For now, we'll just reset the error state
            window.location.reload(); // Simple fallback
        } else {
            // Too many retries, show error message
            alert("We're having trouble downloading the content. Please check your internet connection and refresh the page.");
        }
    };

    // Handle close with localStorage save
    const handleClose = () => {
        if (allMediaReady && agreedToTerms) {
            localStorage.setItem('welcomeOverlayShown', 'true');
            onClose();
        }
    };

    // If it's been shown before, don't render
    if (hasBeenShown) return null;
    if (!isOpen) return null;

    // Check if we can auto-agree
    const canAutoAgree = allMediaReady && !agreedToTerms;

    return (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-0">
            {/* ===== FULL SCREEN DESKTOP LAYOUT ===== */}
            <div className="relative w-full h-full flex flex-col md:flex-row overflow-hidden">

                {/* ===== LEFT SIDE: FORM CARD (Mobile & Desktop) ===== */}
                <div className="w-full md:w-1/2 h-full bg-white/95 backdrop-blur-xl p-6 md:p-12 lg:p-16 overflow-y-auto flex flex-col justify-center relative z-10">

                    {/* Decorative Top Bar - Mobile */}
                    <div className="absolute top-0 left-1/2 -translate-x-1/2 w-16 h-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full md:hidden" />

                    {/* Logo & Title - Mobile */}
                    <div className="space-y-3 md:space-y-4 md:hidden">
                        <div className="relative mx-auto w-20 h-20">
                            <div className="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-500 rounded-2xl blur-lg opacity-30 animate-pulse" />
                            <img
                                src="/pwa-192x192.jpeg"
                                alt="Medrae Logo"
                                className="relative mx-auto h-20 w-20 rounded-2xl shadow-2xl border-4 border-white animate-in zoom-in duration-700"
                            />
                            <div className="absolute -bottom-1 -right-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full p-1.5 border-4 border-white shadow-lg">
                                <div className="w-2 h-2 bg-white rounded-full animate-ping" />
                            </div>
                        </div>
                        <div className="space-y-1">
                            <h2 className="text-3xl font-black tracking-tight animate-in slide-in-from-bottom-4 duration-700 delay-100 text-center">
                                <span className="text-red-600">MEDRAE</span>{' '}
                                <span className="text-slate-800">NURSING</span>
                            </h2>
                            <div className="flex items-center justify-center gap-2">
                                <div className="h-px w-8 bg-gradient-to-r from-transparent to-blue-500" />
                                <p className="text-slate-500 font-bold text-[10px] uppercase tracking-[0.2em] animate-in slide-in-from-bottom-4 duration-700 delay-200">
                                    Kenya's No.1 Nursing Network
                                </p>
                                <div className="h-px w-8 bg-gradient-to-l from-transparent to-blue-500" />
                            </div>
                        </div>
                    </div>

                    {/* Logo & Title - Desktop */}
                    <div className="hidden md:flex items-center gap-4 mb-8">
                        <img
                            src="/pwa-192x192.jpeg"
                            alt="Medrae Logo"
                            className="h-16 w-16 rounded-xl shadow-lg border-2 border-white"
                        />
                        <div>
                            <h2 className="text-2xl font-black tracking-tight">
                                <span className="text-red-600">MEDRAE</span>{' '}
                                <span className="text-slate-800">NURSING</span>
                            </h2>
                            <p className="text-[10px] text-slate-400 font-bold uppercase tracking-widest">
                                Kenya's No.1 Nursing Network
                            </p>
                            <div className="flex items-center gap-2 mt-1 text-[8px] font-black text-blue-600 uppercase tracking-widest">
                                <span className="bg-blue-50 px-2 py-0.5 rounded-full">2,231+ Students</span>
                                <span className="text-slate-300">•</span>
                                <span className="bg-purple-50 px-2 py-0.5 rounded-full text-purple-600">❤️ Wellness First</span>
                            </div>
                        </div>
                    </div>

                    {/* Welcome Message - Desktop */}
                    <div className="hidden md:block mb-6">
                        <h1 className="text-3xl lg:text-4xl font-black text-slate-800 leading-tight">
                            Welcome to Your<br />
                            <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">
                                Nursing Success Journey
                            </span>
                        </h1>
                        <p className="text-slate-500 text-sm mt-2 max-w-md">
                            Kenya's first holistic nursing platform that cares for your mental wellness AND exam success.
                        </p>
                    </div>

                    {/* Download Status and Error Handling */}
                    {downloadError && (
                        <div className="mb-3 p-3 bg-red-50 border border-red-200 rounded-xl animate-in slide-in-from-top-4 duration-300">
                            <div className="flex items-start gap-2">
                                <AlertCircle className="w-4 h-4 text-red-500 mt-0.5 flex-shrink-0" />
                                <div className="flex-1">
                                    <p className="text-xs font-semibold text-red-700">Download Issue Detected</p>
                                    <p className="text-xs text-red-600 mt-0.5">
                                        {retryCount < maxRetries
                                            ? "The download seems to be taking longer than expected. Would you like to retry?"
                                            : "Unable to complete downloads. Please refresh the page."}
                                    </p>
                                    {retryCount < maxRetries && (
                                        <button
                                            onClick={handleRetryDownload}
                                            className="mt-1.5 text-xs font-bold text-red-600 hover:text-red-800 flex items-center gap-1"
                                        >
                                            <RefreshCw className="w-3 h-3" />
                                            Retry Download ({retryCount + 1}/{maxRetries})
                                        </button>
                                    )}
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Terms Agreement */}
                    <div className={`bg-gradient-to-br from-slate-50 to-blue-50/50 rounded-2xl md:rounded-xl p-4 md:p-5 text-left border border-slate-100/80 shadow-inner space-y-3 animate-in slide-in-from-bottom-4 duration-700 delay-300 ${isAutoAgreeing ? 'opacity-50 pointer-events-none' : ''}`}>
                        <div className="flex items-start gap-2">
                            <div className="mt-0.5 p-1 bg-blue-100 rounded-full flex-shrink-0">
                                <Shield className="w-3 h-3 text-blue-600" />
                            </div>
                            <p className="text-slate-600 leading-relaxed text-xs md:text-sm font-medium">
                                Ready to boost your skills, career, and confidence? Before you proceed, please make sure you have read and understood our
                                <span
                                    className="mx-1 underline decoration-blue-200 decoration-2 underline-offset-4 cursor-pointer text-blue-600 hover:text-blue-800 transition-colors font-bold"
                                    onClick={() => navigate("/terms")}
                                >
                                    Terms & Conditions
                                </span>
                                <span
                                    className="mx-1 underline decoration-blue-200 decoration-2 underline-offset-4 cursor-pointer text-blue-600 hover:text-blue-800 transition-colors font-bold"
                                    onClick={() => navigate("/privacy")}
                                >
                                    Privacy Policy
                                </span>
                                .
                            </p>
                        </div>

                        {/* Checkbox Agreement - Now with auto-agree indicator */}
                        <label className="flex items-start gap-3 cursor-pointer group p-2.5 bg-white/60 rounded-xl hover:bg-white transition-all">
                            <div className="relative flex items-center justify-center mt-0.5">
                                <input
                                    type="checkbox"
                                    checked={agreedToTerms}
                                    onChange={(e) => setAgreedToTerms(e.target.checked)}
                                    className="sr-only peer"
                                    disabled={isAutoAgreeing}
                                />
                                <div className={`w-5 h-5 rounded-lg border-2 border-slate-300 peer-checked:border-blue-600 peer-checked:bg-gradient-to-r peer-checked:from-blue-600 peer-checked:to-purple-600 flex items-center justify-center transition-all duration-200 group-hover:border-blue-400 shadow-sm ${isAutoAgreeing ? 'opacity-50' : ''}`}>
                                    <svg
                                        className="w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity duration-200"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        strokeWidth="3"
                                    >
                                        <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                            </div>
                            <span className="text-[10px] md:text-xs text-slate-600 font-medium leading-relaxed">
                                {isAutoAgreeing ? (
                                    <span className="flex items-center gap-2 text-blue-600">
                                        <div className="w-3 h-3 border-2 border-blue-500 border-t-transparent rounded-full animate-spin" />
                                        Auto-confirming agreement...
                                    </span>
                                ) : (
                                    <>
                                        I have read and agree to the{' '}
                                        <span
                                            className="text-blue-600 font-bold hover:underline cursor-pointer"
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                navigate("/terms");
                                            }}
                                        >
                                            Terms & Conditions
                                        </span>{' '}
                                        and{' '}
                                        <span
                                            className="text-blue-600 font-bold hover:underline cursor-pointer"
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                navigate("/privacy");
                                            }}
                                        >
                                            Privacy Policy
                                        </span>
                                    </>
                                )}
                            </span>
                        </label>

                        {/* Auto-agree status message */}
                        {downloadComplete && agreedToTerms && !isAutoAgreeing && (
                            <div className="flex items-center gap-2 text-green-600 text-xs font-medium bg-green-50 p-2 rounded-lg">
                                <CheckCircle className="w-3.5 h-3.5" />
                                <span>✓ You've been automatically agreed! Ready to continue.</span>
                            </div>
                        )}
                    </div>

                    {/* Action Buttons */}
                    <div className="flex flex-col items-center gap-3 md:gap-4 animate-in slide-in-from-bottom-4 duration-700 delay-500 mt-4">
                        <div className="w-full space-y-2 md:space-y-3">
                            <button
                                className={`w-full h-12 md:h-14 rounded-xl md:rounded-2xl font-black text-sm md:text-base transition-all shadow-lg active:scale-[0.98] flex items-center justify-center gap-2 relative overflow-hidden ${!allMediaReady || !agreedToTerms
                                    ? "bg-slate-100 text-slate-400 cursor-not-allowed"
                                    : "bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white shadow-blue-200/50 hover:shadow-blue-300/50 hover:scale-[1.02]"
                                    }`}
                                disabled={!allMediaReady || !agreedToTerms}
                                onClick={handleClose}
                            >
                                {(allMediaReady && agreedToTerms) && (
                                    <span className="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full animate-shimmer" />
                                )}

                                {!allMediaReady ? (
                                    <span className="flex items-center gap-2">
                                        <div className="w-4 h-4 border-2 border-slate-300 border-t-slate-500 rounded-full animate-spin" />
                                        {downloadError ? 'Retrying...' : 'Downloading...'}
                                    </span>
                                ) : !agreedToTerms ? (
                                    <>
                                        {downloadComplete ? (
                                            <span className="flex items-center gap-2">
                                                <div className="w-4 h-4 border-2 border-blue-500 border-t-transparent rounded-full animate-spin" />
                                                Auto-agreeing...
                                            </span>
                                        ) : (
                                            <>
                                                <CheckCircle className="w-4 h-4" />
                                                Please agree to continue
                                            </>
                                        )}
                                    </>
                                ) : (
                                    <>
                                        <Sparkles className="w-4 h-4" />
                                        Yes, I agree! I wanna Read more about Medrae
                                        <ArrowRight className="w-4 h-4" />
                                    </>
                                )}
                            </button>

                            <p className="text-slate-500 text-xs md:text-sm font-medium text-center">
                                Already have an account?{' '}
                                <span
                                    className="text-blue-600 font-black cursor-pointer hover:underline transition-all hover:text-purple-600"
                                    onClick={() => window.location.href = "/login"}
                                >
                                    Log in here
                                </span>
                            </p>
                        </div>

                        {/* Enhanced Progress Bar with Status */}
                        <div className="w-full max-w-sm space-y-1.5 md:space-y-2">
                            <div className="flex justify-between items-end px-1">
                                <span className="text-[8px] md:text-[9px] font-black text-slate-400 uppercase tracking-widest flex items-center gap-1">
                                    <span className={`w-1.5 h-1.5 rounded-full ${allMediaReady ? 'bg-green-500' : downloadError ? 'bg-red-500' : 'bg-blue-500 animate-pulse'}`} />
                                    {downloadError ? 'Error' : allMediaReady ? 'Ready' : 'Loading'}
                                </span>
                                <span className="text-xs font-black text-slate-700 tabular-nums">
                                    {allMediaReady ? "100%" : `${Math.floor((loadedMedia / totalMedia) * 100)}%`}
                                </span>
                            </div>
                            <div className="w-full bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200/50 p-0.5">
                                <div
                                    className="h-full rounded-full transition-all duration-700 ease-out relative"
                                    style={{
                                        width: allMediaReady ? "100%" : `${(loadedMedia / totalMedia) * 100}%`,
                                        background: allMediaReady
                                            ? "linear-gradient(90deg, #10b981, #34d399)"
                                            : downloadError
                                                ? "linear-gradient(90deg, #ef4444, #f87171)"
                                                : loadedMedia / totalMedia <= 0.25
                                                    ? "linear-gradient(90deg, #f43f5e, #fb7185)"
                                                    : loadedMedia / totalMedia <= 0.75
                                                        ? "linear-gradient(90deg, #3b82f6, #60a5fa)"
                                                        : "linear-gradient(90deg, #f59e0b, #fbbf24)",
                                    }}
                                >
                                    {!allMediaReady && !downloadError && (
                                        <div className="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-shimmer" />
                                    )}
                                </div>
                            </div>
                            <p className="text-[8px] md:text-[9px] font-bold text-slate-400 text-center uppercase tracking-tighter">
                                {allMediaReady
                                    ? '✓ Ready to go!'
                                    : downloadError
                                        ? '⚠️ Download interrupted - please refresh'
                                        : `Loading ${loadedMedia} of ${totalMedia}`}
                            </p>

                            {/* Retry counter */}
                            {retryCount > 0 && !allMediaReady && (
                                <p className="text-[8px] text-orange-500 text-center">
                                    Retry attempt {retryCount} of {maxRetries}
                                </p>
                            )}
                        </div>
                    </div>

                    {/* Footer Note */}
                    <div className="text-[8px] text-slate-400 font-medium tracking-wider text-center mt-3 md:mt-4">
                        ❤️ Because a healthy mind passes exams
                    </div>
                </div>

                {/* ===== RIGHT SIDE: FULL SCREEN IMAGE WITH GRADIENT ===== */}
                <div className="hidden md:flex md:w-1/2 h-full relative overflow-hidden">
                    {/* Background Image with Smooth Transition */}
                    <div className="absolute inset-0 transition-all duration-1000 ease-in-out">
                        {backgroundImages.map((img, index) => (
                            <div
                                key={img}
                                className="absolute inset-0 transition-opacity duration-1000 ease-in-out"
                                style={{
                                    opacity: currentImageIndex === index ? 1 : 0,
                                    backgroundImage: `url(${img})`,
                                    backgroundSize: 'cover',
                                    backgroundPosition: 'center',
                                }}
                            />
                        ))}
                        {/* Gradient Overlay */}
                        <div className="absolute inset-0 bg-gradient-to-tl from-slate-900/90 via-blue-900/60 to-purple-900/40" />
                    </div>

                    {/* Content Overlay on Image - Better positioned */}
                    <div className="relative z-10 flex flex-col justify-end p-8 lg:p-12 xl:p-16 text-white h-full">
                        <div className="space-y-4 lg:space-y-6 max-w-md">
                            {/* Badge - Smaller and positioned well */}
                            <div className="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/20 w-fit">
                                <Sparkles className="w-3.5 h-3.5 text-yellow-300" />
                                <span className="text-[10px] font-black uppercase tracking-widest">Welcome to Medrae</span>
                            </div>

                            {/* Main Message - Smaller text for better fit */}
                            <h2 className="text-3xl lg:text-4xl xl:text-5xl font-black leading-tight">
                                Your Mind Meets<br />
                                <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-purple-300">
                                    Your Nursing Career
                                </span>
                            </h2>

                            <p className="text-blue-100/80 text-sm lg:text-base leading-relaxed">
                                Kenya's first holistic nursing platform that cares for your mental wellness AND exam success.
                            </p>

                            <p className="text-blue-200/60 text-xs lg:text-sm">
                                Join 2,231+ nursing students already on their journey.
                            </p>

                            {/* Stats - Smaller and compact */}
                            <div className="flex items-center gap-6 pt-2">
                                <div>
                                    <p className="text-2xl lg:text-3xl font-black">2,231+</p>
                                    <p className="text-[10px] text-blue-200/70 uppercase tracking-wider">Active Students</p>
                                </div>
                                <div className="w-px h-10 bg-white/20" />
                                <div>
                                    <p className="text-2xl lg:text-3xl font-black">95%</p>
                                    <p className="text-[10px] text-blue-200/70 uppercase tracking-wider">Accuracy Rate</p>
                                </div>
                                <div className="w-px h-10 bg-white/20" />
                                <div>
                                    <p className="text-2xl lg:text-3xl font-black">❤️</p>
                                    <p className="text-[10px] text-blue-200/70 uppercase tracking-wider">Wellness First</p>
                                </div>
                            </div>

                            {/* Slide Indicators - More compact */}
                            <div className="flex gap-2 pt-4">
                                {backgroundImages.map((_, index) => (
                                    <button
                                        key={index}
                                        onClick={() => setCurrentImageIndex(index)}
                                        className={`h-1 rounded-full transition-all duration-500 ${currentImageIndex === index
                                            ? 'w-8 bg-white'
                                            : 'w-5 bg-white/30 hover:bg-white/50'
                                            }`}
                                    />
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* Image Counter - Smaller */}
                    <div className="absolute bottom-6 right-6 z-10 bg-black/40 backdrop-blur-sm px-3 py-1.5 rounded-full text-[10px] text-white/80 font-medium">
                        {currentImageIndex + 1} / {backgroundImages.length}
                    </div>
                </div>
            </div>
        </div>
    );
};

export default WelcomeOverlay;